# Database
# For local development with SQLite:
DATABASE_URL="file:./dev.db"
# For production with PostgreSQL (Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Direct database connection (for Prisma migrations):
# DIRECT_URL="postgresql://user:password@host:5432/dbname"

# Authentication
# IMPORTANT: Generate a strong random JWT secret for production
# Use: openssl rand -base64 32
JWT_SECRET="generate-a-strong-random-secret-here"

# App URL (for QR code generation, sitemap, etc.)
# Change to your production domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cafe Configuration
NEXT_PUBLIC_CAFE_NAME="Café"
NEXT_PUBLIC_CAFE_SLUG="cafe"
NEXT_PUBLIC_CAFE_TAGLINE="Experience the Art of Fine Coffee"
NEXT_PUBLIC_CAFE_ADDRESS=""
NEXT_PUBLIC_CAFE_PHONE=""
NEXT_PUBLIC_CAFE_EMAIL=""
NEXT_PUBLIC_CAFE_PRIMARY_COLOR="#C9A962"
NEXT_PUBLIC_CAFE_SECONDARY_COLOR="#3D2914"
NEXT_PUBLIC_CAFE_LANGUAGE="en"
NEXT_PUBLIC_CAFE_ABOUT_TITLE="Our Story"
NEXT_PUBLIC_CAFE_ABOUT_DESCRIPTION=""

# Admin Configuration
ADMIN_EMAIL="admin@cafemenu.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Admin"

# App Settings
NEXT_PUBLIC_CURRENCY="ETB"

# Opening Hours (JSON format)
NEXT_PUBLIC_OPENING_HOURS='{"monday":{"open":"07:00","close":"22:00"},"tuesday":{"open":"07:00","close":"22:00"},"wednesday":{"open":"07:00","close":"22:00"},"thursday":{"open":"07:00","close":"22:00"},"friday":{"open":"07:00","close":"23:00"},"saturday":{"open":"08:00","close":"23:00"},"sunday":{"open":"08:00","close":"21:00"}}'

