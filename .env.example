# Database
# For local development with SQLite:
DATABASE_URL="file:./dev.db"
# For production with PostgreSQL (Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Authentication
# IMPORTANT: Generate a strong random JWT secret for production
# Use: openssl rand -base64 32
JWT_SECRET="generate-a-strong-random-secret-here"

# App URL (for QR code generation)
# Change to your production domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upstash Redis (for rate limiting in production)
# Get these from https://upstash.com
# UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-redis-token"
